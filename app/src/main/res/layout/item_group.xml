<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivGroupAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="?attr/colorSurfaceVariant"
            android:padding="2dp"
            android:src="@drawable/ic_people"
            app:tint="?attr/colorOnSurfaceVariant"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvGroupName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/ivGroupAvatar"
            app:layout_constraintTop_toTopOf="@id/ivGroupAvatar"
            app:layout_constraintEnd_toStartOf="@id/layoutParticipantAvatars"
            tools:text="Wieczorni Kinomaniacy" />

        <TextView
            android:id="@+id/tvGroupMembersCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvGroupName"
            app:layout_constraintTop_toBottomOf="@id/tvGroupName"
            app:layout_constraintEnd_toStartOf="@id/layoutParticipantAvatars"
            tools:text="12 członków | Utworzono 2 dni temu" />

        <LinearLayout
            android:id="@+id/layoutParticipantAvatars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivParticipant1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/colorSurfaceVariant"
                android:scaleType="centerCrop"
                app:strokeWidth="1.5dp"
                app:strokeColor="?attr/colorSurface"
                app:shapeAppearanceOverlay="@style/CircleImageStyle"
                tools:srcCompat="@tools:sample/avatars" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivParticipant2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/colorSurfaceVariant"
                android:scaleType="centerCrop"
                app:strokeWidth="1.5dp"
                app:strokeColor="?attr/colorSurface"
                app:shapeAppearanceOverlay="@style/CircleImageStyle"
                tools:srcCompat="@tools:sample/avatars" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivParticipant3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/colorSurfaceVariant"
                android:scaleType="centerCrop"
                app:strokeWidth="1.5dp"
                app:strokeColor="?attr/colorSurface"
                app:shapeAppearanceOverlay="@style/CircleImageStyle"
                tools:srcCompat="@tools:sample/avatars" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivParticipantEmpty"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/colorSurfaceVariant"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant"
                app:shapeAppearanceOverlay="@style/CircleImageStyle" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>