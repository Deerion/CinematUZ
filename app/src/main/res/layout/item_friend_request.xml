<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorPrimary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivRequestAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:background="?attr/colorPrimaryVariant"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/tvRequestName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            app:layout_constraintStart_toEndOf="@id/ivRequestAvatar"
            app:layout_constraintEnd_toStartOf="@id/btnAccept"
            app:layout_constraintTop_toTopOf="@id/ivRequestAvatar"
            app:layout_constraintBottom_toTopOf="@id/tvRequestInfo"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Kino_Maniak99" />

        <TextView
            android:id="@+id/tvRequestInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:text="Chce dodać Cię do znajomych"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintStart_toStartOf="@id/tvRequestName"
            app:layout_constraintEnd_toStartOf="@id/btnAccept"
            app:layout_constraintTop_toBottomOf="@id/tvRequestName"
            app:layout_constraintBottom_toBottomOf="@id/ivRequestAvatar" />

        <ImageButton
            android:id="@+id/btnAccept"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_square_button_primary"
            android:backgroundTint="?attr/colorPrimary"
            android:src="@drawable/ic_check_circle"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="?attr/colorOnPrimary"
            app:layout_constraintEnd_toStartOf="@id/btnDecline"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnDecline"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_square_button"
            android:backgroundTint="#20808080"
            android:src="@drawable/ic_close"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:tint="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>